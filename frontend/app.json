{
  "expo": {
    "name": "APHC Case Tracker",
    "slug": "aphc-case-tracker",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "aphccasetracker",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F172A"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.aphc.casetracker",
      "infoPlist": {
        "NSSpeechRecognitionUsageDescription": "Allow APHC Case Tracker to transcribe case queries and appearance notes.",
        "NSMicrophoneUsageDescription": "Allow APHC Case Tracker to access your microphone for voice case search."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0F172A"
      },
      "package": "com.aphc.casetracker",
      "versionCode": 1,
      "allowBackup": false,
      "permissions": [
        "INTERNET",
        "RECORD_AUDIO",
        "POST_NOTIFICATIONS",
        "VIBRATE",
        "RECEIVE_BOOT_COMPLETED",
        "android.permission.RECORD_AUDIO"
      ],
      "blockedPermissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "READ_CONTACTS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow APHC Case Tracker to access your microphone for voice case search.",
          "speechRecognitionPermission": "Allow APHC Case Tracker to transcribe case queries and appearance notes."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#D4AF37",
          "sounds": []
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "0c0ce70b-3f7e-48f4-be41-d6cbdad3fd78"
      }
    },
    "owner": "diviii"
  }
}
