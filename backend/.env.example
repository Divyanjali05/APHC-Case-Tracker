# Django Settings
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=placeholder_django_secret_key_change_in_production
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database Settings
# Set DATABASE_URL to PostgreSQL URL, or leave commented out / blank to use local SQLite development database
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/aphc_tracker

# Celery & Redis
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# SimpleJWT
JWT_SECRET_KEY=placeholder_jwt_secret_key_change_in_production
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=14

# CORS Settings
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006
