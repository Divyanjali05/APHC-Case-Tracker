# Django Core Settings
DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL Database Configuration
DB_NAME=highcourt_lawyer_db
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
# Alternatively, a full connection string:
# DATABASE_URL=postgresql://user:password@localhost:5432/highcourt_lawyer_db

# Redis & Celery Configuration
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# SimpleJWT Authentication
JWT_SECRET_KEY=
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=14

# CORS Settings
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006

# Secure Case Document Storage
SECURE_DOCUMENT_ROOT=protected_media/case_documents
MAX_UPLOAD_SIZE_BYTES=10485760

# Push Notifications & FCM Configuration
PUSH_NOTIFICATION_PROVIDER=mock
EXPO_PUSH_ACCESS_TOKEN=
FCM_SERVER_KEY=
FCM_PROJECT_ID=

