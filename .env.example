# ==============================================================================
# APHC Case Tracker - Environment Configuration Template
# ==============================================================================
# Copy this file to backend/.env and frontend/.env respectively, or configure in
# your deployment environment. Never commit real credentials to source control.

# ------------------------------------------------------------------------------
# Backend Configuration (backend/.env)
# ------------------------------------------------------------------------------
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=replace_with_a_secure_random_secret_key
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,testserver

# Database Settings
# Set DATABASE_URL to a PostgreSQL URL for production/staging, or leave blank/commented
# to use local development SQLite (backend/db.sqlite3)
# DATABASE_URL=postgres://user:password@localhost:5432/aphc_tracker

# Celery & Redis
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Authentication & JWT
JWT_SECRET_KEY=replace_with_a_secure_jwt_secret_key
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=14

# CORS & Security
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006
SECURE_SSL_REDIRECT=False

# ------------------------------------------------------------------------------
# Frontend Configuration (frontend/.env)
# ------------------------------------------------------------------------------
EXPO_PUBLIC_API_URL=http://localhost:8000/api
EXPO_PUBLIC_ENV=development
EXPO_PUBLIC_APP_NAME=APHC Case Tracker
EXPO_PUBLIC_DEFAULT_LOCALE=en
EXPO_PUBLIC_ENABLE_DEMO=false
